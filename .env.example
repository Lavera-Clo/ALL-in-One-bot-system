# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Meta WhatsApp Webhook Verification Token
META_VERIFY_TOKEN=my_secure_meta_verify_token_123

# Database. SQLite (one file) is fine for trying it out on one computer.
# In production use the shared PostgreSQL database that the website, the Android app and the
# bot all use - e.g. Supabase: Project Settings -> Database -> Connection string (URI).
# Paste it as-is ("postgresql://..."); the server adds the async driver itself.
# See SHARED_DATABASE.md for moving existing data over.
DATABASE_URL=sqlite+aiosqlite:///./whatsapp_bot.db
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Meta Graph API Base URL / Version
META_GRAPH_API_VERSION=v20.0

# Bootstrap credentials for the first owner account (only read once, when the
# admin_users table is empty). Change the password from the dashboard afterward.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# Public base URL this server is reachable at (used for invoice links and Stripe redirects)
BASE_URL=http://localhost:8000

# Other websites allowed to call this server from a browser, comma separated — e.g. the
# Business Sender site, so owners can sign in there with their platform account and see
# chats, reply, and switch the bot per chat. Leave empty if there is none. Never "*".
CORS_ORIGINS=
# CORS_ORIGINS=https://your-business-sender.vercel.app,http://localhost:3000

# Online payments (optional) — leave as-is to keep the manual bank-transfer flow
STRIPE_SECRET_KEY=sk_placeholder
STRIPE_WEBHOOK_SECRET=

# Minutes of cart inactivity before a customer gets one abandoned-cart reminder
ABANDONED_CART_MINUTES=30

# ---------------------------------------------------------------------------
# AI providers (all optional — configure any combination). The bot tries them
# in order and falls back automatically when one is rate-limited or down.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=            # aistudio.google.com — also reads scanned PDFs and tables
GROQ_API_KEY=              # console.groq.com — fastest, used first for customer replies
MISTRAL_API_KEY=           # console.mistral.ai — activate a plan or the key has 0 quota
OPENROUTER_API_KEY=        # openrouter.ai — access to many free models
OPENROUTER_API_KEY_2=      # optional second OpenRouter key, used when the first is exhausted

# Optional: override which models each job uses, as provider:model,provider:model
# LLM_CHAT_MODELS=groq:openai/gpt-oss-120b,gemini:gemini-flash-latest
